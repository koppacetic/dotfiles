{
  // Theme
  "theme": "Ayu Dark",
  "buffer_font_family": "Monaspace Neon",
  "buffer_font_size": 18,
  "ui_font_family": ".SystemUIFont",
  "ui_font_size": 18,
  "agent_buffer_font_size": 18,
  "agent_ui_font_size": 18,
  "icon_theme": "Catppuccin Mocha",

  // Keymap
  "base_keymap": "Emacs",

  // UI tweaks
  "minimap": {
    "show": "never"
  },
  "hover_popover_sticky": false,
  "cursor_shape": "block",

