#!/bin/bash
USAGE="USAGE: bcopy [-d dest] [-q] hostFile file"
LISTDIRS="${LISTDIRS:-$HOME}"
dest=
quiet=

abort() {
    echo $1
    exit 1
}

# Handle command line options
while true; do
    case $1 in
    -d)
        dest=$2
        shift 2
        ;;

    -q)
        quiet=0
        shift
        ;;

    -*)
        echo $USAGE
        exit 1
        ;;

    *)
        break
        ;;
    esac
done
[[ -z "$2" ]] && abort "$USAGE"

# Get file to copy
hostfile=$1
shift
file=$1

# Find host file
if [[ -f $hostfile ]]; then
    hostlist=$(cat $hostfile)
else
    for d in $LISTDIRS; do
        if [[ -f "$d/$hostfile" ]]; then
            hostlist=$(cat $d/$hostfile)
            break
        fi
    done
fi
[[ -z "$hostlist" ]] && abort "ERROR: Host list file not found: $hostfile"

# Copy file to each host
for host in $hostlist; do
    [[ -z "$quiet" ]] && echo "======== $host ========"

    # Make sure we can ping host
    # if ! ping -c 1 -q -W 2 $host >/dev/null; then
    #     echo "WARNING: $host unresponsive, skipping..."
    #     continue
    # fi

    scp $file $host:$dest
done
