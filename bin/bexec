#!/bin/bash
USAGE="USAGE: bexec [-q] hostFile cmd"
LISTDIRS="${LISTDIRS:-$HOME}"
quiet=
opts=

abort() {
    echo $1
    exit 1
}

# Handle command line options
while true; do
    case $1 in
    -q)
        quiet=1
        shift
        ;;

    -*)
        opts="$opts $1"
        shift
        ;;

    *)
        break
        ;;
    esac
done
[[ -z "$2" ]] && abort "$USAGE"


# Get command to execute
hostfile=$1
shift
cmd="$@"

# Find host file
if [[ -f $hostfile ]]; then
    hostlist=$(cat $hostfile)
else
    for d in $LISTDIRS; do
        if [[ -f "$d/$hostfile" ]]; then
            hostlist=$(cat $d/$hostfile)
            break
        fi
    done
fi
[[ -z "$hostlist" ]] && abort "ERROR: Host list file not found: $hostfile"

# Run command on each host
for host in $hostlist; do
    [[ -z "$quiet" ]] && echo "======== $host ========"

    # Make sure we can ping host
    # if ! ping -c 1 -q -W 2 $host >/dev/null; then
    #     echo "WARNING: $host unresponsive, skipping..."
    #     continue
    # fi

    ssh $opts $host $cmd
done
